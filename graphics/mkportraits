#!/bin/bash

[ -d portraits/ ] || mkdir portraits

(
  cd portraits/
  for n in {0..89}
  do
    file="portrait-$n.bmp"

    if ! [ -f "$file" ]
    then
      echo "Extract $file..."
      ../../gex ../../rings.bin -p "$n" -Mff00ff
    fi
  done
)

OPTIONS="-border 1 -bordercolor white -tile 8x -geometry +1+1 -background transparent -compose copy"

montage $OPTIONS portraits/portrait-{23,17,20,6,48,49,74}.bmp portraits-1.bmp
montage $OPTIONS portraits/portrait-{43,41,42,9,44,45,0,1,2,4,7,8,10,11,12,39,46,47,51,55,56,58,{61..66},{75..78},84}.bmp portraits-2.bmp
montage $OPTIONS portraits/portrait-{36,37,3,50,54,40,38}.bmp portraits-3.bmp
montage $OPTIONS portraits/portrait-{21,22,5,35}.bmp portraits-4.bmp
montage $OPTIONS portraits/portrait-{{14..16},18,19,{24..33},71,73,83,85,89}.bmp portraits-5.bmp
montage $OPTIONS portraits/portrait-{13,{67..69},72,81,{86..88}}.bmp portraits-6.bmp
montage $OPTIONS portraits/portrait-{34,79}.bmp portraits-7.bmp

OPTIONS="-border 0 -tile 1x -geometry +1+1 -gravity south -background pink -font FreeSans -pointsize 12 +set label -transparent #ff00ff"

[ -f portraits.png ] ||
montage $OPTIONS \
  label:"Buc's party" portraits-1.bmp \
  label:"General NPCs" portraits-2.bmp \
  label:"Specific NPCs" portraits-3.bmp \
  label:"Crafts" portraits-4.bmp \
  label:"Locations" portraits-5.bmp \
  label:"Things" portraits-6.bmp \
  label:"Unused" portraits-7.bmp \
  portraits.png
